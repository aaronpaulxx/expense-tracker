{
  "name": "expense-tracker",
  "private": true,
  "version": "1.3.1",
  "type": "module",
  "main": "main.js",
  "scripts": {
    "dev": "vite",
    "electron:dev": "concurrently \"vite dev\" \"electron .\"",
    "electron:build": "vite build && electron-builder",
    "electron:preview": "vite build && electron .",
    "lint": "eslint ."
  },
  "build": {
    "appId": "com.expense-tracker.app",
    "productName": "Expense Tracker",
    "directories": {
      "output": "release/"
    },
    "afterPack": "build/afterPack.cjs",
    "compression": "normal",
    "files": [
      "dist/**/*",
      "main.js",
      "preload.cjs",
      "splash.html",
      "splash.css"
    ],
    "extraResources": [
      "splash.html",
      "splash.css"
    ],
    "win": {
      "target": "nsis",
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "asar": {
    "unpack": [
      "preload.cjs"
    ]
  },
  "dependencies": {
    "@headlessui/react": "^2.2.10",
    "@hello-pangea/dnd": "^18.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "axios": "^1.19.0",
    "lucide-react": "^0.475.0",
    "prettier": "^3.9.6",
    "prop-types": "^15.8.1",
    "react": "^19.2.8",
    "react-datepicker": "^8.0.0",
    "react-dom": "^19.2.8",
    "recharts": "^2.15.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@babel/core": "^7.26.10",
    "@eslint/js": "^9.19.0",
    "@types/node": "^22.13.10",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^1.3.2",
    "autoprefixer": "^10.5.4",
    "concurrently": "^9.1.2",
    "electron": "^34.1.1",
    "electron-builder": "^25.1.8",
    "eslint": "^9.20.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^15.14.0",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "vite": "^6.2.2"
  },
  "description": "Expense Tracker",
  "keywords": [],
  "author": "",
  "license": "ISC"
}
