{
  "name": "expense-tracker",
  "private": true,
  "version": "1.3.0",
  "type": "module",
  "main": "main.js",
  "scripts": {
    "dev": "vite",
    "electron:dev": "concurrently \"vite dev\" \"electron .\"",
    "electron:build": "vite build && electron-builder",
    "electron:preview": "vite build && electron ."
  },
  "build": {
    "appId": "com.expense-tracker.app",
    "productName": "Expense Tracker",
    "directories": {
      "output": "release/"
    },
    "afterPack": "build/afterPack.cjs",
    "compression": "maximum",
    "files": [
      "dist/**/*",
      "main.js",
      "preload.cjs",
      "splash.html",
      "splash.css"
    ],
    "extraResources": [
      "splash.html",
      "splash.css"
    ],
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "asar": {
    "unpack": [
      "preload.cjs"
    ]
  },
  "dependencies": {
    "@headlessui/react": "^2.2.0",
    "@hello-pangea/dnd": "^18.0.1",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-tooltip": "^1.1.8",
    "@tailwindcss/vite": "^4.0.14",
    "axios": "^1.7.9",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.6.2",
    "lucide-react": "^0.475.0",
    "prettier": "3.5.3",
    "prop-types": "^15.8.1",
    "react": "^19.0.0",
    "react-datepicker": "^8.0.0",
    "react-dom": "^19.0.0",
    "react-select": "^5.10.0",
    "recharts": "^2.15.1",
    "tailwind-merge": "^3.0.2",
    "tailwind-scrollbar-hide": "^2.0.0",
    "tailwindcss-animate": "^1.0.7",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@babel/core": "^7.26.10",
    "@eslint/js": "^9.19.0",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^1.3.2",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "electron": "^34.1.1",
    "electron-builder": "^25.1.8",
    "eslint": "^9.20.1",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.18",
    "globals": "^15.14.0",
    "postcss": "^8.5.1",
    "tailwindcss": "^4.0.14",
    "vite": "^6.2.2"
  },
  "description": "Expense Tracker",
  "keywords": [],
  "author": "",
  "license": "ISC"
}
